# The packages the app uses directly. requirements.txt is generated from this
# file with every package (including their dependencies) pinned to an exact
# version, so a new release can't change the app without passing the tests
# first. Dependabot proposes updates to requirements.txt weekly.
#
# To regenerate requirements.txt after editing this file:
#   uv pip compile requirements.in --python-version 3.14 \
#       --python-platform x86_64-manylinux_2_28 -o requirements.txt

anthropic        # Claude API: the AI step (metadata.fetch_llm)
curl_cffi        # browser-like page fetching (http_fetch.py)
pypdf            # PDF text extraction (metadata._extract_pdf_text)
pyzotero         # Zotero API (zotero_client.py, zotero_index.py)
streamlit        # the web page (app.py)
watchdog         # Streamlit's file watcher (also installed by Streamlit itself)
