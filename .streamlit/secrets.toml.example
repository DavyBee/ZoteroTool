# The settings the app needs. On Streamlit Cloud, paste these lines into the
# app's Settings > Secrets box and fill in the values.

ZOTERO_API_KEY = ""          # zotero.org/settings/keys, with write access to the library
ZOTERO_LIBRARY_ID = ""       # the number in the group library's URL
ZOTERO_LIBRARY_TYPE = "group"
ZOTERO_COLLECTION_KEY = ""   # optional: upload into this collection instead of the library root

ANTHROPIC_API_KEY = ""       # console.anthropic.com
LLM_MODEL = ""               # optional: blank uses the default model
